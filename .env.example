# Zoom (required)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=

# Bot display name
ZOOM_BOT_DISPLAY_NAME=Instruction Bot (Recording)

# Whitelist: comma-separated meeting IDs and/or host emails
# Bot joins ONLY these meetings. Leave empty to join none.
ZOOM_WHITELIST_MEETING_IDS=
ZOOM_WHITELIST_HOST_EMAILS=

# OpenAI (for summaries)
OPENAI_API_KEY=

# Database
DATABASE_URL=sqlite:///./zoombot.db

# Optional: Redis for async processing
REDIS_URL=redis://localhost:6379

# Optional: Object storage (MinIO/S3) for audio
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=zoom-audio
